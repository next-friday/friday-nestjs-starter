{
  "*.{ts,js,mjs,cjs}": [
    "pnpm exec eslint --fix --cache --max-warnings=0 --no-warn-ignored",
    "prettier --write --cache"
  ],
  "!(package).json": ["prettier --write --cache"],
  "*.{md,yml,yaml}": ["prettier --write --cache"],
  "package.json": ["sort-package-json", "prettier --write --cache"]
}
